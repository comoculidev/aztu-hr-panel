# Kopyalayın: .env.example → .env (git-ə düşmür) və dəyərləri yazın.

# Veb server
PORT=3000
HOST=0.0.0.0
BAZA_YOLU=data/hr.db

# Kamera sistemi (192.0.2.77) — onun muhit.env faylındakı HR_API_ACAR ilə EYNİ açar.
# Yaratmaq: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_ACAR=
# Kamera API-sinə yalnız bu IP-lərdən icazə (vergüllə)
INGEST_IP=192.0.2.77

# İş qrafiki (gecikmə və erkən çıxış üçün)
IS_BASLAMA=09:00
IS_BITME=18:00

# Sessiya müddəti, saat
SESSIYA_SAAT=8
# HTTPS (nginx) arxasındadırsa true
TEHLUKESIZ_KUKI=false
PROXY_ETIBAR=false
